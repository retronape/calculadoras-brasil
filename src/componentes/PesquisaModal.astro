---
---

<button id="btn-pesquisa" class="btn-pesquisa" aria-label="Pesquisar" title="Pesquisar (Ctrl+K)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="btn-pesquisa-texto">Pesquisar…</span>
  <kbd class="btn-pesquisa-kbd">Ctrl+K</kbd>
</button>

<div id="pesquisa-modal-overlay" class="pesquisa-overlay" hidden>
  <div class="pesquisa-modal" role="dialog" aria-label="Pesquisa">
    <div class="pesquisa-cabecalho">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="pesquisa-input"
        class="pesquisa-input"
        placeholder="Digite para pesquisar..."
        autocomplete="off"
        aria-label="Pesquisar calculadoras"
      />
      <button id="pesquisa-fechar" class="pesquisa-fechar" aria-label="Fechar">&times;</button>
    </div>
    <div id="pesquisa-resultados" class="pesquisa-resultados">
      <p class="pesquisa-vazio">Nenhum resultado encontrado.</p>
    </div>
    <div class="pesquisa-rodape">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span>
      <span><kbd>Enter</kbd> selecionar</span>
      <span><kbd>Esc</kbd> fechar</span>
    </div>
  </div>
</div>

<script>
  interface ItemPesquisa {
    titulo: string
    url: string
    descricao: string
  }

  const itens: ItemPesquisa[] = Array.from(
    document.querySelectorAll<HTMLElement>('[data-pesquisa-titulo]')
  ).map((el) => ({
    titulo: el.getAttribute('data-pesquisa-titulo') || '',
    url: el.getAttribute('data-pesquisa-url') || '#',
    descricao: el.getAttribute('data-pesquisa-descricao') || ''
  }))

  let indiceAtivo = -1
  let itensFiltrados: ItemPesquisa[] = []

  const overlay = document.getElementById('pesquisa-modal-overlay') as HTMLElement
  const input = document.getElementById('pesquisa-input') as HTMLInputElement
  const resultadosDiv = document.getElementById('pesquisa-resultados') as HTMLElement
  const btnAbrir = document.getElementById('btn-pesquisa') as HTMLButtonElement
  const btnFechar = document.getElementById('pesquisa-fechar') as HTMLButtonElement

  function abrir() {
    overlay.hidden = false
    input.value = ''
    input.focus()
    indiceAtivo = -1
    filtrar('')
  }

  function fechar() {
    overlay.hidden = true
    input.value = ''
  }

  function filtrar(termo: string) {
    const termoLower = termo.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    itensFiltrados = termo.trim() === ''
      ? itens.slice(0, 10)
      : itens.filter((item) => {
          const t = item.titulo.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          const d = item.descricao.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          return t.includes(termoLower) || d.includes(termoLower)
        })

    indiceAtivo = -1
    renderizar()
  }

  function renderizar() {
    if (itensFiltrados.length === 0) {
      resultadosDiv.innerHTML = '<p class="pesquisa-vazio">Nenhum resultado encontrado.</p>'
      return
    }

    resultadosDiv.innerHTML = itensFiltrados
      .map((item, i) => `
        <a href="${item.url}" class="pesquisa-item${i === indiceAtivo ? ' ativo' : ''}" data-indice="${i}">
          <strong>${item.titulo}</strong>
          ${item.descricao ? `<span>${item.descricao}</span>` : ''}
        </a>
      `)
      .join('')
  }

  function navegar(direcao: number) {
    if (itensFiltrados.length === 0) return
    indiceAtivo = (indiceAtivo + direcao + itensFiltrados.length) % itensFiltrados.length
    renderizar()

    const el = resultadosDiv.querySelector(`[data-indice="${indiceAtivo}"]`)
    if (el) el.scrollIntoView({ block: 'nearest' })
  }

  function selecionar() {
    if (indiceAtivo >= 0 && indiceAtivo < itensFiltrados.length) {
      window.location.href = itensFiltrados[indiceAtivo].url
    }
  }

  btnAbrir.addEventListener('click', abrir)
  btnFechar.addEventListener('click', fechar)

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) fechar()
  })

  input.addEventListener('input', () => {
    filtrar(input.value)
  })

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault()
      navegar(1)
    } else if (e.key === 'ArrowUp') {
      e.preventDefault()
      navegar(-1)
    } else if (e.key === 'Enter') {
      e.preventDefault()
      selecionar()
    } else if (e.key === 'Escape') {
      fechar()
    }
  })

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && !isInputFocused())) {
      e.preventDefault()
      if (overlay.hidden) {
        abrir()
      } else {
        fechar()
      }
    }
  })

  function isInputFocused(): boolean {
    const active = document.activeElement
    return active?.tagName === 'INPUT' || active?.tagName === 'TEXTAREA' || (active as HTMLElement)?.isContentEditable === true
  }
</script>

<style>
  .btn-pesquisa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--cor-borda, #ccc);
    border-radius: 0.375rem;
    background: var(--cor-fundo, #fff);
    color: var(--cor-texto-muted, #666);
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 150ms, box-shadow 150ms;
  }

  .btn-pesquisa:hover {
    border-color: var(--cor-primaria, #2563eb);
    box-shadow: 0 0 0 2px var(--cor-primaria-light, #93bbfd);
  }

  .btn-pesquisa-texto {
    display: none;
  }

  .btn-pesquisa-kbd {
    display: none;
  }

  @media (min-width: 640px) {
    .btn-pesquisa-texto {
      display: inline;
    }
    .btn-pesquisa-kbd {
      display: inline-block;
      padding: 0.1rem 0.35rem;
      border: 1px solid var(--cor-borda, #ccc);
      border-radius: 0.25rem;
      font-size: 0.7rem;
      font-family: monospace;
      background: var(--cor-fundo-alt, #f5f5f5);
    }
  }

  .pesquisa-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }

  .pesquisa-modal {
    width: 90%;
    max-width: 560px;
    background: var(--cor-fundo, #fff);
    border-radius: 0.75rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .pesquisa-cabecalho {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--cor-borda, #eee);
  }

  .pesquisa-cabecalho svg {
    flex-shrink: 0;
    color: var(--cor-texto-muted, #999);
  }

  .pesquisa-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    background: transparent;
    color: var(--cor-texto, #1a1a1a);
  }

  .pesquisa-fechar {
    border: none;
    background: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--cor-texto-muted, #999);
    padding: 0.25rem;
    line-height: 1;
  }

  .pesquisa-fechar:hover {
    color: var(--cor-texto, #1a1a1a);
  }

  .pesquisa-resultados {
    max-height: 320px;
    overflow-y: auto;
    padding: 0.25rem 0;
  }

  .pesquisa-vazio {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--cor-texto-muted, #999);
    font-size: 0.9rem;
  }

  .pesquisa-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 1rem;
    text-decoration: none;
    color: var(--cor-texto, #1a1a1a);
    transition: background 100ms;
  }

  .pesquisa-item:hover,
  .pesquisa-item.ativo {
    background: var(--cor-fundo-hover, #f0f4ff);
  }

  .pesquisa-item strong {
    font-size: 0.9rem;
  }

  .pesquisa-item span {
    font-size: 0.8rem;
    color: var(--cor-texto-muted, #888);
  }

  .pesquisa-rodape {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--cor-borda, #eee);
    font-size: 0.75rem;
    color: var(--cor-texto-muted, #999);
  }

  .pesquisa-rodape kbd {
    display: inline-block;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--cor-borda, #ccc);
    border-radius: 0.2rem;
    font-size: 0.7rem;
    font-family: monospace;
    background: var(--cor-fundo-alt, #f5f5f5);
  }
</style>
