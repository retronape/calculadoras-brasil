---
---

<button id="btn-pesquisa" class="btn-pesquisa" aria-label="Pesquisar" title="Pesquisar (Ctrl+K)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="btn-pesquisa-texto">Pesquisar…</span>
  <kbd class="btn-pesquisa-kbd">Ctrl+K</kbd>
</button>

<div id="pesquisa-modal-overlay" class="pesquisa-overlay" hidden>
  <div class="pesquisa-modal" role="dialog" aria-label="Pesquisa">
    <div class="pesquisa-cabecalho">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="pesquisa-input"
        class="pesquisa-input"
        placeholder="Digite para pesquisar..."
        autocomplete="off"
        aria-label="Pesquisar calculadoras"
      />
      <button id="pesquisa-fechar" class="pesquisa-fechar" aria-label="Fechar">&times;</button>
    </div>
    <div id="pesquisa-resultados" class="pesquisa-resultados">
    </div>
    <div class="pesquisa-rodape">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span>
      <span><kbd>Enter</kbd> selecionar</span>
      <span><kbd>Esc</kbd> fechar</span>
    </div>
  </div>
</div>

<script>
  import { itensPesquisa, filtrarItens } from '../lib/pesquisa.ts'

  const overlay = document.getElementById('pesquisa-modal-overlay') as HTMLElement
  const input = document.getElementById('pesquisa-input') as HTMLInputElement
  const resultadosDiv = document.getElementById('pesquisa-resultados') as HTMLElement
  const btnAbrir = document.getElementById('btn-pesquisa') as HTMLButtonElement
  const btnFechar = document.getElementById('pesquisa-fechar') as HTMLButtonElement

  let indiceAtivo = -1
  let itensFiltrados: typeof itensPesquisa = []

  function abrir() {
    overlay.hidden = false
    input.value = ''
    input.focus()
    indiceAtivo = -1
    mostrarTodos()
  }

  function fechar() {
    overlay.hidden = true
    input.value = ''
  }

  function normalizar(s: string): string {
    return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
  }

  function mostrarTodos() {
    itensFiltrados = itensPesquisa.slice(0, 12)
    indiceAtivo = -1
    renderizar()
  }

  function filtrar(termo: string) {
    if (termo.trim().length < 2) {
      mostrarTodos()
      return
    }
    itensFiltrados = filtrarItens(termo)
    indiceAtivo = -1
    renderizar()
  }

  function renderizar() {
    if (itensFiltrados.length === 0) {
      resultadosDiv.innerHTML = '<p class="pesquisa-vazio">Nenhum resultado encontrado.</p>'
      return
    }

    const catLabels: Record<string, string> = {
      calculadora: 'Calculadora',
      utilidade: 'Utilidade',
      curiosidade: 'Curiosidade'
    }

    resultadosDiv.innerHTML = itensFiltrados
      .map((item, i) => {
        const cor: Record<string, string> = {
          calculadora: 'var(--primaria)',
          utilidade: 'var(--verde)',
          curiosidade: 'var(--rose)'
        }
        const label = catLabels[item.categoria] || item.categoria
        const c = cor[item.categoria] || 'var(--primaria)'
        return `
          <a href="${item.slug}" class="pesquisa-item${i === indiceAtivo ? ' ativo' : ''}" data-indice="${i}">
            <div class="pesquisa-item-cabecalho">
              <strong>${item.titulo}</strong>
              <span class="pesquisa-item-categoria" style="color:${c}">${label}</span>
            </div>
            ${item.descricao ? `<span class="pesquisa-item-desc">${item.descricao}</span>` : ''}
          </a>
        `
      })
      .join('')
  }

  function navegar(direcao: number) {
    if (itensFiltrados.length === 0) return
    indiceAtivo = (indiceAtivo + direcao + itensFiltrados.length) % itensFiltrados.length
    renderizar()
    const el = resultadosDiv.querySelector(`[data-indice="${indiceAtivo}"]`)
    if (el) el.scrollIntoView({ block: 'nearest' })
  }

  function selecionar() {
    if (indiceAtivo >= 0 && indiceAtivo < itensFiltrados.length) {
      window.location.href = itensFiltrados[indiceAtivo].slug
    }
  }

  btnAbrir.addEventListener('click', abrir)
  btnFechar.addEventListener('click', fechar)
  overlay.addEventListener('click', (e) => { if (e.target === overlay) fechar() })
  input.addEventListener('input', () => filtrar(input.value))

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); navegar(1) }
    else if (e.key === 'ArrowUp') { e.preventDefault(); navegar(-1) }
    else if (e.key === 'Enter') { e.preventDefault(); selecionar() }
    else if (e.key === 'Escape') { fechar() }
  })

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && !isInputFocused())) {
      e.preventDefault()
      if (overlay.hidden) abrir(); else fechar()
    }
  })

  function isInputFocused(): boolean {
    const active = document.activeElement
    return active?.tagName === 'INPUT' || active?.tagName === 'TEXTAREA' || (active as HTMLElement)?.isContentEditable === true
  }
</script>

<style>
  .btn-pesquisa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--borda, #ccc);
    border-radius: 0.375rem;
    background: var(--superficie, #fff);
    color: var(--mutado-claro, #666);
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .btn-pesquisa:hover { border-color: var(--primaria, #2563eb); box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.3) }
  .btn-pesquisa-texto { display: none }
  .btn-pesquisa-kbd { display: none }
  @media (min-width: 640px) {
    .btn-pesquisa-texto { display: inline }
    .btn-pesquisa-kbd { display: inline-block; padding: 0.1rem 0.35rem; border: 1px solid var(--borda, #ccc); border-radius: 0.25rem; font-size: 0.7rem; font-family: monospace; background: var(--superficie2, #f5f5f5) }
  }

  .pesquisa-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); z-index: 10000; display: flex; align-items: flex-start; justify-content: center; padding-top: 10vh }
  .pesquisa-modal { width: 90%; max-width: 560px; background: var(--superficie, #fff); border: 1px solid var(--borda, #eee); border-radius: 0.75rem; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); overflow: hidden }
  .pesquisa-cabecalho { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--borda, #eee) }
  .pesquisa-cabecalho svg { flex-shrink: 0; color: var(--mutado-claro, #999) }
  .pesquisa-input { flex: 1; border: none; outline: none; font-size: 1rem; background: transparent; color: var(--texto, #1a1a1a) }
  .pesquisa-input::placeholder { color: var(--mutado-claro, #999) }
  .pesquisa-fechar { border: none; background: none; font-size: 1.25rem; cursor: pointer; color: var(--mutado-claro, #999); padding: 0.25rem; line-height: 1 }
  .pesquisa-fechar:hover { color: var(--texto, #1a1a1a) }

  .pesquisa-resultados { max-height: 380px; overflow-y: auto; padding: 0.25rem 0 }
  .pesquisa-vazio { text-align: center; padding: 2rem 1rem; color: var(--mutado-claro, #999); font-size: 0.9rem }
  .pesquisa-item { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.65rem 1rem; text-decoration: none; color: var(--texto, #1a1a1a); transition: background 100ms }
  .pesquisa-item:hover, .pesquisa-item.ativo { background: var(--superficie2, #f0f4ff) }
  .pesquisa-item-cabecalho { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem }
  .pesquisa-item-cabecalho strong { font-size: 0.9rem }
  .pesquisa-item-categoria { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap }
  .pesquisa-item-desc { font-size: 0.8rem; color: var(--mutado-claro, #888) }
  .pesquisa-rodape { display: flex; gap: 1rem; padding: 0.5rem 1rem; border-top: 1px solid var(--borda, #eee); font-size: 0.75rem; color: var(--mutado-claro, #999) }
  .pesquisa-rodape kbd { display: inline-block; padding: 0.05rem 0.3rem; border: 1px solid var(--borda, #ccc); border-radius: 0.2rem; font-size: 0.7rem; font-family: monospace; background: var(--superficie2, #f5f5f5) }
</style>