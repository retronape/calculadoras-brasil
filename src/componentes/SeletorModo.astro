---
---

<div id="seletor-modo" class="seletor-modo">
  <button data-modo="leve" title="Leve – menos animações e efeitos">🪶 Leve</button>
  <button data-modo="padrao" title="Padrão – experiência equilibrada">⚡ Padrão</button>
  <button data-modo="rico" title="Rico – mais efeitos visuais">✨ Rico</button>
  <button data-modo="maximo" title="Máximo – todos os efeitos e anúncios">🚀 Máximo</button>
</div>

<div id="badge-modo" class="badge-modo" style="display:none;"></div>

<script>
  import { salvar, ler } from '../lib/storage.ts'
  const MODOS = ['leve', 'padrao', 'rico', 'maximo'] as const

  function obterModoAtual(): string {
    return document.documentElement.getAttribute('data-modo') || 'padrao'
  }

  function aplicarModo(modo: string) {
    console.log('[DEBUG] Aplicando modo visual:', modo)
    document.documentElement.setAttribute('data-modo', modo)

    // Ajustar propriedades de animação baseadas no modo
    if (modo === 'leve') {
      document.documentElement.style.setProperty('--animacao-duracao', '0ms')
      document.documentElement.style.setProperty('--animacao-escala', '1')
    } else if (modo === 'padrao') {
      document.documentElement.style.setProperty('--animacao-duracao', '150ms')
      document.documentElement.style.setProperty('--animacao-escala', '1')
    } else if (modo === 'rico') {
      document.documentElement.style.setProperty('--animacao-duracao', '250ms')
      document.documentElement.style.setProperty('--animacao-escala', '1.02')
    } else {
      document.documentElement.style.setProperty('--animacao-duracao', '350ms')
      document.documentElement.style.setProperty('--animacao-escala', '1.05')
    }

    // Atualizar botões no seletor
    const container = document.getElementById('seletor-modo')
    if (container) {
      container.querySelectorAll('button').forEach((btn) => {
        const btnModo = btn.getAttribute('data-modo')
        btn.classList.toggle('ativo', btnModo === modo)
      })
    }

    // Mostrar o badge de feedback
    const badge = document.getElementById('badge-modo')
    if (badge) {
      const labels: Record<string, string> = {
        leve: '🪶 Modo Leve',
        padrao: '⚡ Modo Padrão',
        rico: '✨ Modo Rico',
        maximo: '🚀 Modo Máximo'
      }
      badge.textContent = labels[modo] || modo
      badge.style.display = 'block'
      badge.style.opacity = '1'
      setTimeout(() => {
        badge.style.opacity = '0'
        setTimeout(() => { badge.style.display = 'none' }, 200)
      }, 2000)
    }
    
    // Notificar o BaseLayout para ativar/desativar CSS
    window.dispatchEvent(new CustomEvent('modoMudou', { detail: { modo } }))
  }

  function inicializar() {
    const salvo = ler<string>('modo')
    console.log('[DEBUG] Modo inicial carregado:', salvo)
    if (salvo && (MODOS as readonly string[]).includes(salvo)) {
      aplicarModo(salvo)
    } else {
      aplicarModo(obterModoAtual())
    }

    const container = document.getElementById('seletor-modo')
    if (container) {
      container.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button')
        if (!btn) return
        const modo = btn.getAttribute('data-modo')
        if (!modo) return
        console.log('[DEBUG] Usuário selecionou modo:', modo)
        salvar('modo', modo)
        aplicarModo(modo)
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inicializar)
  } else {
    inicializar()
  }
</script>

    <style>
  .seletor-modo {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0.5rem;
  }

  .seletor-modo button {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--borda, #ccc);
    border-radius: 0.375rem;
    background: var(--superficie, #fff);
    color: var(--texto, #1a1a1a);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 150ms, border-color 150ms, box-shadow 150ms;
  }

  .seletor-modo button:hover {
    background: var(--superficie2, #f0f0f0);
  }

  .seletor-modo button.ativo {
    background: var(--primaria, #2563eb);
    color: #fff;
    border-color: var(--primaria, #2563eb);
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.3);
  }

  .badge-modo {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    padding: 0.5rem 1rem;
    background: var(--primaria, #2563eb);
    color: #fff;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 9999;
    pointer-events: none;
    transition: opacity 200ms;
  }
</style>
