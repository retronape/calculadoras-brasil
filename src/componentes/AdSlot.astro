---
import { siteConfig } from '../config/site.ts'

export interface Props {
  posicao: 'resultado' | 'secundario' | 'interno' | 'inline' | 'rodape-pagina'
}

const { posicao } = Astro.props

const slotMap: Record<string, string> = {
  resultado: siteConfig.adsense.slotResultado,
  secundario: siteConfig.adsense.slotSecundario,
  interno: siteConfig.adsense.slotResultado,
  inline: siteConfig.adsense.slotSecundario,
  'rodape-pagina': siteConfig.adsense.slotResultado
}

const slot = slotMap[posicao] || siteConfig.adsense.slotResultado
const classe = posicao === 'interno' ? 'ad-interno' : posicao === 'inline' ? 'ad-inline' : posicao === 'rodape-pagina' ? 'ad-rodape-pagina' : 'ad-container'
---

{siteConfig.adsense.habilitado && (
  <div class={classe} data-ad-posicao={posicao}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={siteConfig.adsense.clientId}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
)}

<script>
  function podeCarregarAnuncios(): boolean {
    const modo = document.documentElement.getAttribute('data-modo')
    if (modo !== 'rico' && modo !== 'maximo') return false

    try {
      const consent = localStorage.getItem('cb:consent-ads')
      if (consent === 'false') return false
    } catch {}

    return true
  }

  function inicializar() {
    if (!podeCarregarAnuncios()) return

    const containers = document.querySelectorAll<HTMLElement>('[data-ad-posicao]')
    containers.forEach((container) => {
      try {
        const ins = container.querySelector('ins.adsbygoogle')
        if (ins) {
          ;(window as any).adsbygoogle = (window as any).adsbygoogle || []
          ;(window as any).adsbygoogle.push({})
        }
      } catch {}
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inicializar)
  } else {
    inicializar()
  }
</script>

<style>
  .ad-container {
    margin: 1.5rem 0;
    text-align: center;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>