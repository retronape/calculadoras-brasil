---
/**
 * Layout base de todas as páginas.
 * Inclui boot script ES5 que roda antes da pintura pra evitar flash de tema errado.
 */
import { siteConfig } from '../config/site.ts'
import { tabelas } from '../lib/tabelas.ts'
import SeletorModo from '../componentes/SeletorModo.astro'
import DiagnosticoNivel from '../componentes/DiagnosticoNivel.astro'
import PesquisaModal from '../componentes/PesquisaModal.astro'

const isDev = import.meta.env.DEV

interface Props { titulo: string; descricao: string; rota?: string }

const { titulo, descricao, rota } = Astro.props
const caminho = rota ?? Astro.url.pathname
const urlCanonica = siteConfig.url + (caminho === '/' ? '/' : caminho)
const tituloPagina = titulo.includes(siteConfig.nome) ? titulo : titulo + ' · ' + siteConfig.nome
---

<!doctype html>
<html lang="pt-BR" data-tema="dark" data-modo="rico">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#050a13" />

    <!--
      Estilo base embutido: funciona sem JavaScript e em navegadores antigos (modo leve).
      CSS literal sem custom properties — garante renderização em qualquer dispositivo.
    -->
    <style is:global>
      html, body { margin: 0; padding: 0 }
      body { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, Cantarell, 'Helvetica Neue', Arial, sans-serif; line-height: 1.55; color: #1c2733; background: #fff; padding: 0 0 2rem; transition: background-color 0.2s, color 0.2s }
      html[data-tema='dark'] body { background: #02050a; color: #f5f8fc }
      .container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 1rem }
      .cabecalho-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; padding: .6rem 0 }
      .marca { font-weight: 700; color: #0b5e76; text-decoration: none; display: flex; align-items: center; gap: .4rem }
      html[data-tema='dark'] .marca { color: #38bdf8 }
      .nav-principal { display: flex; flex-wrap: wrap; gap: .6rem; font-size: .92rem }
      .nav-principal a { color: #0b5e76; text-decoration: none }
      html[data-tema='dark'] .nav-principal a { color: #d0dcec }
      .controles-sitio { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-left: auto }
      .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap }
      img { max-width: 100%; height: auto }
      [hidden] { display: none !important }
    </style>

    <!-- Folhas de tema: só carregam quando o modo não é leve -->
    <link rel="stylesheet" href="/styles/tokens.css" media="not all" id="css-tokens" />
    <link rel="stylesheet" href="/styles/temas.css" media="not all" id="css-temas" />

    <!--
      Boot script ES5: roda antes da pintura.
      1. Restaura tema salvo (padrão: escuro).
      2. Detecta modo visual salvo ou auto-detecta.
      3. Ativa as folhas de tema corretas.
    -->
    <script is:inline>
      ;(function () {
        var d = document.documentElement
        function pegar(c) {
          try {
            var v = window.localStorage.getItem('cb:' + c)
            console.log('[DEBUG] Recuperando cb:' + c, v)
            if (v === null) return null
            try { 
              var p = JSON.parse(v)
              console.log('[DEBUG] JSON.parse ok:', p)
              return p 
            } catch (e) { 
              console.log('[DEBUG] JSON.parse falhou, retornando valor original')
              return v 
            }
          } catch (e) { 
            console.log('[DEBUG] Erro ao acessar localStorage')
            return null 
          }
        }

        // Tema (padrão: escuro)
        var tema = pegar('tema')
        console.log('[DEBUG] Tema recuperado da persistência:', tema)
        
        if (tema !== 'light') {
            console.log('[DEBUG] Tema não é "light", definindo como "dark"')
            tema = 'dark'
        } else {
            console.log('[DEBUG] Tema é "light"')
        }
        
        d.setAttribute('data-tema', tema)
        console.log('[DEBUG] data-tema definido como:', tema)
        
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) {
            var novaCor = (tema === 'dark' ? '#050a13' : '#eef3fb')
            meta.setAttribute('content', novaCor)
            console.log('[DEBUG] meta theme-color definido como:', novaCor)
        }

        // Modo visual
        var modos = ['leve', 'padrao', 'rico', 'maximo']
        var salvo = pegar('modo')
        console.log('[DEBUG] Modo salvo:', salvo)
        var modo = (salvo && modos.indexOf(salvo) !== -1) ? salvo : null

        if (!modo) {
          var cores = 0, mem = 0
          try {
            if (typeof navigator !== 'undefined') {
              if (typeof navigator.hardwareConcurrency === 'number') cores = navigator.hardwareConcurrency
              if (typeof navigator.deviceMemory === 'number') mem = navigator.deviceMemory
            }
          } catch (e) {}
          if (cores >= 8 && mem >= 6) modo = 'maximo'
          else if (cores >= 4 && mem >= 4) modo = 'rico'
          else if (cores >= 2) modo = 'padrao'
          else modo = 'leve'
          
          // Salvar modo detectado
          try {
            window.localStorage.setItem('cb:modo', modo)
          } catch (e) {}
        }

        d.setAttribute('data-modo', modo)

        // Ativa CSS
        var tk = document.getElementById('css-tokens')
        var tm = document.getElementById('css-temas')
        if (tk) tk.setAttribute('media', modo === 'leve' ? 'not all' : 'all')
        if (tm) tm.setAttribute('media', modo === 'leve' ? 'not all' : 'all')

        // Listener para mudanças de modo em tempo real
        if (typeof window !== 'undefined') {
          window.addEventListener('modoMudou', function(e) {
            var novoModo = e.detail?.modo
            if (novoModo && ['leve', 'padrao', 'rico', 'maximo'].includes(novoModo)) {
              d.setAttribute('data-modo', novoModo)
              if (tk) tk.setAttribute('media', novoModo === 'leve' ? 'not all' : 'all')
              if (tm) tm.setAttribute('media', novoModo === 'leve' ? 'not all' : 'all')
            }
          })
        }
      })()
    </script>
  </head>
  <body>
    <a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <noscript>
      <div class="container">
        <p class="aviso-noscript">
          <strong>JavaScript desativado:</strong> as calculadoras precisam de JavaScript para funcionar. Enquanto
          estiver assim, use as <a href="/tabelas-fixas/">Tabelas Fixas</a> com valores já calculados.
        </p>
      </div>
    </noscript>
    <header class="cabecalho">
      <div class="container cabecalho-inner">
        <a class="marca" href="/" aria-label={siteConfig.nome}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="3" stroke="#38bdf8" stroke-width="2" />
            <path d="M7 9h4M7 13h4M14 9h3M14 13h3M9 16h6" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" />
          </svg>
          {siteConfig.marcaCurta}
        </a>
        <nav class="nav-principal" aria-label="Navegação principal">
          <a href="/">Início</a>
          <a href="/utilidades/">Utilidades</a>
          <a href="/curiosidade/">Curiosidades</a>
          <a href="/tabelas-fixas/">Tabelas Fixas</a>
          <a href="/politica-de-privacidade/">Privacidade</a>
          <a href="/termos-de-uso/">Termos</a>
        </nav>
        <div class="controles-sitio">
          <PesquisaModal />
          <SeletorModo />
          <button type="button" class="botao-tema" data-alternar-tema aria-label="Alternar tema">
            <svg class="icone-sol" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <svg class="icone-lua" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="conteudo" class="container">
      <slot />
    </main>
    <footer class="rodape">
      <div class="container rodape-inner">
        <div class="rodape-aviso">
          <p>
            <strong>Os resultados desta página são estimativas com finalidade educacional e informativa</strong>,
            calculadas com base na legislação vigente até {tabelas.meta.vigenciaAte}
            ({tabelas.meta.fonte}). Elas <strong>não possuem valor legal</strong> e não substituem a orientação de
            um contador, advogado trabalhista ou consultor de investimentos credenciado pela CVM.
          </p>
          <p>
            O {siteConfig.nome} é um <strong>projeto independente</strong> e não é afiliado, endossado nem um canal
            oficial do INSS, Receita Federal, Banco Central do Brasil, gov.br ou de qualquer órgão governamental.
            Veja os <a href="/avisos-legais/">Avisos Legais completos</a>.
          </p>
        </div>
        <div class="rodape-links">
          <a href="/tabelas-fixas/">Tabelas Fixas</a>
          <a href="/politica-de-privacidade/">Privacidade</a>
          <a href="/termos-de-uso/">Termos de Uso</a>
          <a href="/avisos-legais/">Avisos Legais</a>
          <a href="#" id="contato-link" data-user="gabriel58392626" data-domain="gmail.com">Contato</a>
          {import.meta.env.DEV && <button type="button" class="rodape-link" data-abrir-diagnostico>Diagnóstico</button>}
        </div>
        <p class="rodape-meta">
          © {new Date().getFullYear()} {siteConfig.nome} · Independente.
          <a href={siteConfig.githubUrl} rel="noopener" target="_blank" class="rodape-github">Código no GitHub</a>
        </p>
      </div>
      <div class="container">
        {isDev && <DiagnosticoNivel />}
      </div>
    </footer>

    <!-- Consentimento de cookies/anúncios -->
    <div id="consentimento" class="consentimento" role="region" aria-label="Aviso de cookies" hidden>
      <p>
        <strong>Privacidade e anúncios</strong> — Este site usa o Google AdSense. Você pode aceitar anúncios
        personalizados ou apenas não personalizados. Seus dados de cálculo nunca saem do seu dispositivo.
        Veja a <a href="/politica-de-privacidade/">Política de Privacidade</a>.
      </p>
      <div class="consentimento-acoes">
        <button type="button" class="botao" data-escolha="personalizado">Aceitar personalizados</button>
        <button type="button" class="botao botao-secundario" data-escolha="nao-personalizado">Apenas não personalizados</button>
      </div>
    </div>

    <script>
      import { ler, salvar } from '../lib/storage.ts'

      const doc = document.documentElement

      // Construir email de contato (proteção contra scrapers)
      const contatoLink = document.getElementById('contato-link') as HTMLAnchorElement | null
      if (contatoLink) {
        const user = contatoLink.getAttribute('data-user')
        const domain = contatoLink.getAttribute('data-domain')
        if (user && domain) {
          contatoLink.href = 'mailto:' + user + '@' + domain
          contatoLink.textContent = user + '@' + domain
        }
      }

      // Alternar tema
      try {
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        document.querySelector<HTMLButtonElement>('[data-alternar-tema]')?.addEventListener('click', () => {
          const atual = doc.getAttribute('data-tema') === 'light' ? 'light' : 'dark'
          const novo = atual === 'dark' ? 'light' : 'dark'
          doc.setAttribute('data-tema', novo)
          salvar('tema', novo)
          if (meta) meta.setAttribute('content', novo === 'dark' ? '#050a13' : '#eef3fb')
        })
      } catch {}

      // Consentimento
      try {
        const banner = document.getElementById('consentimento')
        if (banner && !ler<string>('consentimento-ads')) {
          banner.hidden = false
          banner.querySelectorAll<HTMLButtonElement>('[data-escolha]').forEach((b) => {
            b.addEventListener('click', () => { salvar('consentimento-ads', b.dataset.escolha ?? ''); banner.hidden = true })
          })
        }
      } catch {}

      // Service worker (só em modos visuais)
      try {
        const modo = doc.getAttribute('data-modo') || 'rico'
        if (modo !== 'leve' && 'serviceWorker' in navigator) {
          window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}))
        }
      } catch {}
    </script>
  </body>
</html>
