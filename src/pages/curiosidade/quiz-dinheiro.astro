---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout titulo="Quiz de Dinheiro" descricao="Teste seus conhecimentos sobre finanças." rota="/curiosidade/quiz-dinheiro/">
  <nav class="trilha"><a href="/">Início</a> / <a href="/curiosidade/">Curiosidades</a> / <span>Quiz</span></nav>
  <h1>❓ Quiz de Dinheiro</h1>
  <p class="subtitulo">Teste seus conhecimentos sobre finanças pessoais e economia brasileira.</p>
  
  <div id="quiz-container">
    <div id="pergunta-atual" class="resultado" style="margin-top: 1rem;">
      <div class="resultado-conteudo">
        <h2 id="pergunta-titulo" style="margin: 0 0 1rem;"></h2>
        <div id="opcoes" style="display: grid; gap: 0.5rem;"></div>
      </div>
    </div>
    
    <div style="margin-top: 1rem; text-align: center;">
      <div id="progresso" style="margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--mutado);"></div>
      <button type="button" class="botao" id="btn-iniciar" onclick="iniciarQuiz()">Iniciar Quiz</button>
    </div>
  </div>
  
  <div id="resultado-quiz" style="display: none;" class="resultado" style="margin-top: 1rem;">
    <div class="resultado-conteudo">
      <h2 style="margin: 0 0 1rem;">Resultado</h2>
      <p id="placar" style="font-size: 1.3rem; font-weight: 700;"></p>
      <p id="badge" style="font-size: 1.1rem;"></p>
      <button type="button" class="botao" onclick="reiniciarQuiz()">Jogar Novamente</button>
    </div>
  </div>

  <section class="explicacao">
    <h2>Sobre o Quiz</h2>
    <p>As perguntas são baseadas em conhecimentos gerais sobre finanças pessoais, impostos e investimentos no Brasil.</p>
    <p>Seu placar é salvo localmente — volte quantas vezes quiser para melhorar!</p>
  </section>
</BaseLayout>

<script is:inline>
  const perguntas = [
    { pergunta: "Qual o salário mínimo brasileiro em 2026?", opcoes: ["R$ 1.412", "R$ 1.621", "R$ 1.800", "R$ 2.000"], resposta: 1 },
    { pergunta: "Qual a alíquota máxima do Imposto de Renda no Brasil?", opcoes: ["15%", "22,5%", "27,5%", "30%"], resposta: 2 },
    { pergunta: "O que é FGTS?", opcoes: ["Fundo de Garantia do Tempo de Serviço", "Fundo Geral de Tributação sobre Salários", "Fiscalização Geral do Trabalho", "Fundo de Gestão de Taxas Salariais"], resposta: 0 },
    { pergunta: "Qual destes NÃO é um tipo de investimento de renda fixa?", opcoes: ["CDB", "Tesouro Direto", "Ações", "LCI"], resposta: 2 },
    { pergunta: "Quanto tempo leva para o FGTS render juros?", opcoes: ["Mensalmente", "Anualmente", "A cada 2 anos", "Nunca"], resposta: 1 },
    { pergunta: "Qual a taxa Selic atual aproximada (2026)?", opcoes: ["5% ao ano", "10,5% ao ano", "15% ao ano", "20% ao ano"], resposta: 1 },
    { pergunta: "O que acontece se você sacar o FGTS sem justa causa?", opcoe: ["Perde o dinheiro", "Recebe multa de 40%", "Paga IR de 27,5%", "Nada acontece"], resposta: 1 },
    { pergunta: "Qual a idade mínima para se aposentar (homem) na reforma de 2019?", opcoes: ["60 anos", "62 anos", "65 anos", "70 anos"], resposta: 2 },
    { pergunta: "O que é o 'desconto simplificado' do IRPF?", opcoes: ["20% dos rendimentos", "5% dos rendimentos", "R$ 607,20 fixos", "Isenção total"], resposta: 0 },
    { pergunta: "Qual o teto do INSS em 2026?", opcoes: ["R$ 7.000", "R$ 8.475,55", "R$ 10.000", "R$ 12.000"], resposta: 1 }
  ]

  let perguntaAtual = 0
  let acertos = 0
  let respondendo = false

  function iniciarQuiz() {
    perguntaAtual = 0
    acertos = 0
    respondendo = true
    document.getElementById('btn-iniciar').style.display = 'none'
    document.getElementById('resultado-quiz').style.display = 'none'
    mostrarPergunta()
  }

  function mostrarPergunta() {
    if (perguntaAtual >= perguntas.length) {
      mostrarResultado()
      return
    }
    
    const p = perguntas[perguntaAtual]
    document.getElementById('pergunta-titulo').textContent = 'Pergunta ' + (perguntaAtual + 1) + '/' + perguntas.length + ': ' + p.pergunta
    
    const opcoesEl = document.getElementById('opcoes')
    opcoesEl.innerHTML = p.opcoes.map(function(op, i) {
      return '<button type="button" class="botao" onclick="responder(' + i + ')" style="text-align: left; padding: 0.7rem;">' + op + '</button>'
    }).join('')
    
    document.getElementById('progresso').textContent = (perguntaAtual + 1) + ' de ' + perguntas.length
  }

  function responder(indice) {
    if (!respondendo) return
    respondendo = false
    
    const p = perguntas[perguntaAtual]
    const botoes = document.querySelectorAll('#opcoes button')
    
    botoes.forEach(function(btn, i) {
      btn.disabled = true
      if (i === p.resposta) {
        btn.style.background = 'var(--verde)'
        btn.style.color = '#fff'
      } else if (i === indice && indice !== p.resposta) {
        btn.style.background = 'var(--rose)'
        btn.style.color = '#fff'
      }
    })
    
    if (indice === p.resposta) acertos++
    
    setTimeout(function() {
      perguntaAtual++
      respondendo = true
      mostrarPergunta()
    }, 1000)
  }

  function mostrarResultado() {
    document.getElementById('quiz-container').style.display = 'none'
    document.getElementById('resultado-quiz').style.display = 'block'
    
    const porcentagem = (acertos / perguntas.length) * 100
    let badge = ''
    if (porcentagem >= 90) badge = '🏆 Mestre do Dinheiro!'
    else if (porcentagem >= 70) badge = '🎯 Investidor Esperto'
    else if (porcentagem >= 50) badge = '📚 Estudante Financeiro'
    else badge = '🌱 Iniciante Curioso'
    
    document.getElementById('placar').textContent = 'Você acertou ' + acertos + ' de ' + perguntas.length + ' perguntas (' + porcentagem.toFixed(0) + '%)'
    document.getElementById('badge').textContent = badge
    
    // Salvar placar
    try {
      const melhorPlacar = localStorage.getItem('cb:quiz-melhor')
      if (!melhorPlacar || acertos > parseInt(melhorPlacar)) {
        localStorage.setItem('cb:quiz-melhor', acertos.toString())
      }
    } catch(e) {}
  }

  function reiniciarQuiz() {
    document.getElementById('quiz-container').style.display = 'block'
    document.getElementById('resultado-quiz').style.display = 'none'
    document.getElementById('btn-iniciar').style.display = 'block'
  }
</script>