---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout titulo="Mapa Salarial" descricao="Salários por profissão no Brasil." rota="/curiosidade/mapa-salarial/">
  <nav class="trilha"><a href="/">Início</a> / <a href="/curiosidade/">Curiosidades</a> / <span>Mapa Salarial</span></nav>
  <h1>🗺️ Mapa Salarial</h1>
  <p class="subtitulo">Veja quanto ganham diferentes profissões no Brasil.</p>
  
  <form class="formulario" novalidate style="margin-bottom: 1rem;">
    <div class="campos">
      <div class="campo">
        <label for="busca">Buscar profissão</label>
        <input type="text" id="busca" placeholder="Ex.: médico, professor..." oninput="filtrar()">
      </div>
    </div>
  </form>
  
  <div style="overflow-x: auto;">
    <table class="tabela-fixa" id="tabela">
      <thead>
        <tr>
          <th>Profissão</th>
          <th>Salário Médio</th>
          <th>Em Salários Mínimos</th>
        </tr>
      </thead>
      <tbody id="corpo-tabela">
      </tbody>
    </table>
  </div>

  <section class="explicacao">
    <h2>Fontes</h2>
    <p>Salários baseados em dados do IBGE, CAGED e pesquisas de mercado (2025/2026). Valores são médias nacionais e podem variar por região, experiência e especialização.</p>
    <p>Salário mínimo 2026: <strong>R$ 1.621,00</strong></p>
  </section>
</BaseLayout>

<script is:inline>
  const salarioMinimo = 1621.0
  const profissoes = [
    { nome: "Médico", salario: 15000 },
    { nome: "Engenheiro", salario: 12000 },
    { nome: "Advogado", salario: 8000 },
    { nome: "Dentista", salario: 10000 },
    { nome: "Professor", salario: 4500 },
    { nome: "Enfermeiro", salario: 5000 },
    { nome: "Contador", salario: 6000 },
    { nome: "Psicólogo", salario: 5500 },
    { nome: "Farmacêutico", salario: 6500 },
    { nome: "Arquiteto", salario: 7000 },
    { nome: "Designer", salario: 5000 },
    { nome: "Programador", salario: 9000 },
    { nome: "Jornalista", salario: 4500 },
    { nome: "Administrador", salario: 6500 },
    { nome: "Nutricionista", salario: 5000 },
    { nome: "Fisioterapeuta", salario: 4500 },
    { nome: "Veterinário", salario: 6000 },
    { nome: "Geógrafo", salario: 4500 },
    { nome: "Bibliotecário", salario: 4000 },
    { nome: "Técnico de TI", salario: 6000 },
    { nome: "Estilista", salario: 5500 },
    { nome: "Zootecnista", salario: 5000 }
  ]

  function filtrar() {
    const busca = document.getElementById('busca').value.toLowerCase()
    const filtrados = profissoes.filter(p => p.nome.toLowerCase().includes(busca))
    renderizar(filtrados)
  }

  function renderizar(lista) {
    const corpo = document.getElementById('corpo-tabela')
    if (!corpo) return
    corpo.innerHTML = lista.map(p => {
      const minSal = (p.salario / salarioMinimo).toFixed(1)
      return `<tr>
        <td>${p.nome}</td>
        <td>R$ ${p.salario.toLocaleString('pt-BR')}</td>
        <td>${minSal} salários</td>
      </tr>`
    }).join('')
  }

  renderizar(profissoes)
</script>