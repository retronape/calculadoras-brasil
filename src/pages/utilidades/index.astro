---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdSlot from '../../componentes/AdSlot.astro'

const utilidades = [
  { slug: 'calendario-clt', titulo: 'Calendário CLT', descricao: 'Veja seus próximos direitos: 13º, férias, feriados.', icone: '📅', categoria: 'trabalho' },
  { slug: 'conversor-salario', titulo: 'Conversor de salário', descricao: 'Salário mensal → hora, dia, semana, ano.', icone: '💰', categoria: 'trabalho' },
  { slug: 'clt-vs-pj', titulo: 'CLT vs PJ', descricao: 'Compare lado a lado qual escolher.', icone: '⚖️', categoria: 'trabalho' },
  { slug: 'conversor-moedas', titulo: 'Conversor de moedas', descricao: 'BRL ↔ USD/EUR com taxas aproximadas.', icone: '💱', categoria: 'utilidade' },
  { slug: 'linha-do-tempo', titulo: 'Linha do tempo financeira', descricao: 'Projeção de quanto teria guardando X por mês.', icone: '📈', categoria: 'investimentos' },
  { slug: 'tempo-de-trabalho', titulo: 'Tempo de trabalho', descricao: 'Quanto tempo pra comprar um celular, carro, casa?', icone: '⏱️', categoria: 'trabalho' },
  { slug: 'perfil-financeiro', titulo: 'Perfil financeiro', descricao: 'Quiz: qual seu estilo financeiro?', icone: '🧠', categoria: 'utilidade' },
  { slug: 'rastreador-inflacao', titulo: 'Rastreador de inflação', descricao: 'Quanto valia R$100 em 2010 vs hoje?', icone: '📊', categoria: 'investimentos' },
  { slug: 'orcamento-estudantil', titulo: 'Orçamento Estudantil', descricao: 'Planeje suas finanças como estudante.', icone: '🎓', categoria: 'estudos' },
  { slug: 'plano-estudos', titulo: 'Plano de Estudos', descricao: 'Organize seus horários de estudos.', icone: '📚', categoria: 'estudos' },
  { slug: 'comparador-cursos', titulo: 'Comparador de Cursos', descricao: 'Compare cursos e universidades.', icone: '🏫', categoria: 'estudos' },
  { slug: 'tracker-estudos', titulo: 'Tracker de Estudos', descricao: 'Acompanhe seu progresso nos estudos.', icone: '✅', categoria: 'estudos' }
]
---

<BaseLayout titulo="Utilidades" descricao="Ferramentas práticas para o dia a dia." rota="/utilidades/">
  <section class="hero">
    <h1>Utilidades</h1>
    <p class="subtitulo">Ferramentas que vão além das calculadoras.</p>
  </section>

  <h2>Ferramentas</h2>
  <ul class="grade-calculadoras">
    {utilidades.map((u) => (
      <li>
        <a class="cartao" href={'/utilidades/' + u.slug + '/'} data-categoria={u.categoria}>
          <div class="cartao-topo">
            <span class="cartao-icone">{u.icone}</span>
            <span class="cartao-etiqueta">{u.categoria === 'estudos' ? 'Estudos' : u.categoria === 'trabalho' ? 'Trabalho' : u.categoria === 'investimentos' ? 'Investimentos' : 'Utilidade'}</span>
          </div>
          <h3>{u.titulo}</h3>
          <p>{u.descricao}</p>
        </a>
      </li>
    ))}
  </ul>

  <AdSlot posicao="interno" />

  <section class="explicacao">
    <h2>Sobre</h2>
    <p>Estas ferramentas são <strong>educacionais e informativas</strong>. Consulte sempre um profissional antes de decisões financeiras.</p>
  </section>
</BaseLayout>