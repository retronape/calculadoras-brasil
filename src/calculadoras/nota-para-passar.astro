---
import CalculatorLayout from '../layouts/CalculatorLayout.astro'
import CampoFormulario from '../componentes/CampoFormulario.astro'

const { meta } = Astro.props
---

<CalculatorLayout meta={meta}>
  <div id="notas-container">
    <CampoFormulario nome="nota_1" rotulo="Nota 1" tipo="number" min="0" max="10" step="0.1" />
    <CampoFormulario nome="peso_1" rotulo="Peso 1" tipo="number" min="1" max="10" valor="1" />
  </div>
  <button type="button" id="add-nota" class="botao-secundario" style="margin-bottom:1rem;">Adicionar Nota</button>
  <CampoFormulario nome="mediaDesejada" rotulo="Média para passar (final)" tipo="number" min="0" max="10" step="0.1" obrigatorio />
</CalculatorLayout>

<script>
  import { parseNumero } from '../lib/format.ts'
  import { mostrarResultado, mostrarErro, linha, grupo, campoValor } from '../lib/resultado.ts'

  const container = document.getElementById('notas-container')
  const addBtn = document.getElementById('add-nota')
  let count = 1

  addBtn?.addEventListener('click', () => {
    count++
    const div = document.createElement('div')
    div.innerHTML = `
      <div class="campo">
        <label for="campo-nota_${count}">Nota ${count}</label>
        <input type="number" id="campo-nota_${count}" name="nota_${count}" min="0" max="10" step="0.1" />
      </div>
      <div class="campo">
        <label for="campo-peso_${count}">Peso ${count}</label>
        <input type="number" id="campo-peso_${count}" name="peso_${count}" min="1" max="10" value="1" />
      </div>
    `
    container?.appendChild(div)
  })

  const formulario = document.getElementById('form-calculadora') as HTMLFormElement | null
  if (formulario) {
    formulario.addEventListener('submit', (e) => {
      e.preventDefault()
      let somaProdutos = 0
      let somaPesosConhecidos = 0
      let pesoFaltante = 0

      for (let i = 1; i <= count; i++) {
        const notaEl = formulario.elements.namedItem(`nota_${i}`) as HTMLInputElement | null
        const pesoEl = formulario.elements.namedItem(`peso_${i}`) as HTMLInputElement | null
        const peso = parseNumero(pesoEl?.value ?? '1')
        const notaVal = notaEl?.value

        if (notaVal && notaVal !== '') {
          somaProdutos += parseNumero(notaVal) * peso
          somaPesosConhecidos += peso
        } else {
          pesoFaltante += peso
        }
      }

      const mediaDesejada = parseNumero(campoValor(formulario, 'mediaDesejada'))
      if (!mediaDesejada || mediaDesejada <= 0) {
        mostrarErro('Informe a média desejada.')
        return
      }

      const totalPesos = somaPesosConhecidos + pesoFaltante
      const notaNecessaria = ((mediaDesejada * totalPesos) - somaProdutos) / (pesoFaltante || 1)

      mostrarResultado(
        grupo('Resultado', [
          linha('Média desejada', mediaDesejada.toFixed(2)),
          linha('Peso restante', String(pesoFaltante)),
          pesoFaltante > 0
            ? linha('Nota necessária', notaNecessaria > 0 ? notaNecessaria.toFixed(2) : 'Não é possível atingir a média', 'total')
            : linha('Média atual', (somaProdutos / (somaPesosConhecidos || 1)).toFixed(2), 'total')
        ])
      )
    })
  }
</script>
