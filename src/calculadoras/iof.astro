---
import CalculatorLayout from '../layouts/CalculatorLayout.astro'
import CampoFormulario from '../componentes/CampoFormulario.astro'
import { tabelas } from '../lib/tabelas.ts'

const { meta } = Astro.props
---

<CalculatorLayout meta={meta}>
  <CampoFormulario nome="valor" rotulo="Valor da Operação (R$)" tipo="number" prefixo="R$" min="0" step="0.01" inputmode="decimal" obrigatorio />
  <CampoFormulario nome="dias" rotulo="Dias de permanência" tipo="number" min="0" valor="10" />
  <CampoFormulario nome="tipo" rotulo="Tipo de Operação" tipo="select" opcoes={[{valor: 'credito', rotulo: 'Crédito'}, {valor: 'cambio', rotulo: 'Câmbio'}]} valor="credito" />
</CalculatorLayout>

<script>
  import { calcularIof } from '../lib/tributos.ts'
  import { tabelas } from '../lib/tabelas.ts'
  import { moeda, parseNumero, percentual } from '../lib/format.ts'
  import { mostrarResultado, mostrarErro, linha, grupo, campoValor } from '../lib/resultado.ts'

  const formulario = document.getElementById('form-calculadora') as HTMLFormElement | null
  if (formulario) {
    formulario.addEventListener('submit', (e) => {
      e.preventDefault()
      const valor = parseNumero(campoValor(formulario, 'valor'))
      const dias = parseInt(campoValor(formulario, 'dias') || '10')
      const tipo = (campoValor(formulario, 'tipo') || 'credito') as 'credito' | 'cambio'

      if (!valor || valor <= 0) {
        mostrarErro('Informe o valor da operação.')
        return
      }

      const r = calcularIof({ valor, dias, tipo })

      mostrarResultado(
        grupo('Cálculo de IOF', [
          linha('Valor Original', moeda(valor)),
          linha('Alíquota IOF', percentual(r.aliquota)),
          linha('IOF', moeda(r.valor)),
          linha('Total (valor + IOF)', moeda(r.total), 'total')
        ])
      )
    })
  }
</script>
