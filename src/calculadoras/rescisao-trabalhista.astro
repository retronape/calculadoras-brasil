---
import CalculatorLayout from '../layouts/CalculatorLayout.astro'
import CampoFormulario from '../componentes/CampoFormulario.astro'
import { tabelas } from '../lib/tabelas.ts'

const { meta } = Astro.props
---

<CalculatorLayout meta={meta}>
  <CampoFormulario nome="salario" rotulo="Salário Mensal (R$)" tipo="number" prefixo="R$" min="0" step="0.01" inputmode="decimal" obrigatorio />
  <CampoFormulario nome="diasTrabalhados" rotulo="Dias trabalhados no mês" tipo="number" min="0" max="31" valor="30" />
  <CampoFormulario nome="mesesTrabalhados" rotulo="Meses na empresa" tipo="number" min="0" valor="12" />
  <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;margin-top:0.5rem;">
    <input type="checkbox" name="avisoIndenizado" /> Aviso Prévio Indenizado
  </label>
  <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;margin-top:0.5rem;">
    <input type="checkbox" name="semJustaCausa" checked /> Demissão sem justa causa
  </label>
  <CampoFormulario nome="saldoFgts" rotulo="Saldo FGTS acumulado (R$)" tipo="number" prefixo="R$" min="0" step="0.01" valor="0" />
</CalculatorLayout>

<script>
  import { calcularRescisao } from '../lib/tributos.ts'
  import { tabelas } from '../lib/tabelas.ts'
  import { moeda, parseNumero, percentual } from '../lib/format.ts'
  import { mostrarResultado, mostrarErro, linha, grupo, campoValor } from '../lib/resultado.ts'

  const formulario = document.getElementById('form-calculadora') as HTMLFormElement | null
  if (formulario) {
    formulario.addEventListener('submit', (e) => {
      e.preventDefault()
      const salario = parseNumero(campoValor(formulario, 'salario'))
      const diasTrabalhados = parseInt(campoValor(formulario, 'diasTrabalhados') || '30')
      const mesesTrabalhados = parseInt(campoValor(formulario, 'mesesTrabalhados') || '12')
      const avisoIndenizado = (formulario.elements.namedItem('avisoIndenizado') as HTMLInputElement)?.checked ?? false
      const semJustaCausa = (formulario.elements.namedItem('semJustaCausa') as HTMLInputElement)?.checked ?? true
      const saldoFgts = parseNumero(campoValor(formulario, 'saldoFgts') || '0')

      if (!salario || salario <= 0) {
        mostrarErro('Informe o salário mensal.')
        return
      }

      const r = calcularRescisao({ salario, diasTrabalhados, mesesTrabalhados, avisoIndenizado, semJustaCausa, saldoFgts }, tabelas)

      mostrarResultado(
        grupo('Cálculo Rescisório', [
          linha('Saldo de Salário', moeda(r.saldoSalario)),
          linha('Aviso Prévio', moeda(r.avisoPrevio)),
          linha('13º Proporcional', moeda(r.trezeProporcional)),
          linha('Férias + 1/3', moeda(r.feriasProporcionais)),
          linha('Depósitos FGTS do período', moeda(r.fgtsPeriodo)),
          linha('Multa FGTS 40%', moeda(r.multaFgts)),
          linha('Total Estimado', moeda(r.total), 'total')
        ])
      )
    })
  }
</script>
