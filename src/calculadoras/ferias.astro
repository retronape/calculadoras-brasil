---
import CalculatorLayout from '../layouts/CalculatorLayout.astro'
import CampoFormulario from '../componentes/CampoFormulario.astro'
import { tabelas } from '../lib/tabelas.ts'

const { meta } = Astro.props
---

<CalculatorLayout meta={meta}>
  <CampoFormulario nome="salario" rotulo="Salário Mensal (R$)" tipo="number" prefixo="R$" min="0" step="0.01" inputmode="decimal" obrigatorio />
  <CampoFormulario nome="mesesTrabalhados" rotulo="Meses trabalhados no período aquisitivo" tipo="number" min="1" max="12" valor="12" />
  <CampoFormulario nome="diasNoUltimoMes" rotulo="Dias no último mês trabalhado" tipo="number" min="1" max="31" valor="30" />
  <CampoFormulario nome="dependentes" rotulo="Número de dependentes" tipo="number" min="0" valor="0" />
</CalculatorLayout>

<script>
  import { feriasProporcionais } from '../lib/tributos.ts'
  import { tabelas } from '../lib/tabelas.ts'
  import { moeda, parseNumero } from '../lib/format.ts'
  import { mostrarResultado, mostrarErro, linha, grupo, campoValor } from '../lib/resultado.ts'

  const formulario = document.getElementById('form-calculadora') as HTMLFormElement | null
  if (formulario) {
    formulario.addEventListener('submit', (e) => {
      e.preventDefault()
      const salario = parseNumero(campoValor(formulario, 'salario'))
      const mesesTrabalhados = parseInt(campoValor(formulario, 'mesesTrabalhados') || '12')
      const diasNoUltimoMes = parseInt(campoValor(formulario, 'diasNoUltimoMes') || '30')
      const dependentes = parseInt(campoValor(formulario, 'dependentes') || '0')

      if (!salario || salario <= 0) {
        mostrarErro('Informe o salário mensal.')
        return
      }

      const r = feriasProporcionais({ salario, mesesTrabalhados, diasNoUltimoMes, dependentes }, tabelas)

      mostrarResultado(
        grupo('Cálculo de Férias', [
          linha('Férias Proporcionais', moeda(r.bruto)),
          linha('1/3 Constitucional', moeda(r.terco)),
          linha('Total Bruto (férias + 1/3)', moeda(r.totalBruto)),
          linha('INSS', moeda(r.inss)),
          linha('IRRF', moeda(r.irrf)),
          linha('Valor Líquido', moeda(r.liquido), 'total')
        ])
      )
    })
  }
</script>
